APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
PORTAL_USERNAME=finance
PORTAL_PASSWORD=SET_PORTAL_PASSWORD
FERNET_KEY=SET_FERNET_KEY
DEMO_MODE=0
# Admin-managed Google OAuth web application. Enable Drive API and Drive MCP API.
# Register PUBLIC_BASE_URL + /auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Hosted Vercel mode: Upstash REST store for encrypted grants and short-lived workflow data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Notion MCP registers its own OAuth client; no NOTION_TOKEN is required.
NOTION_DATA_SOURCE_ID=
NOTION_DATABASE_URL=
# Defaults can be changed inside Settings after login.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_UPLOAD_FOLDER_ID=
RESELLER_TEMPLATE_ID=
LOI_TEMPLATE_ID=
